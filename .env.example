# Copy this file to .env and edit it locally. Never commit .env or share its API key.
# Option A: an OpenAI-compatible remote provider (remote requests require per-goal confirmation).
NEXORA_MODEL_BASE_URL=https://openrouter.ai/api/v1
NEXORA_MODEL_API_KEY=
NEXORA_MODEL_NAME=provider/model-name
NEXORA_ALLOW_REMOTE_MODEL=0

# Option B: local Ollama/OpenAI-compatible endpoint (no remote API key needed).
# Replace the values above with these, and set the model name to one installed locally.
# NEXORA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# NEXORA_MODEL_API_KEY=
# NEXORA_MODEL_NAME=qwen2.5:3b
